# Copy to .env for local development. Never commit real values.
# Production secrets live in /opt/kelola-kasir/.env on the VPS (template: ops/vps/env.example),
# Cloudflare Pages and GitHub Actions secrets, never in the repo. Production setup: docs/ops/deploy.md.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL 16, e.g. postgres://user:password@localhost:5432/kelola_kasir
DATABASE_URL=
# Session (non-pooled) URL for migrations. Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=
DB_POOL_MAX=5

# Base64 of an Ed25519 PKCS#8 private key: `pnpm --filter @kelola-kasir/api keys:generate`.
# Optional in development/test (an ephemeral key is generated), required in production.
JWT_PRIVATE_KEY=

# At least 32 random characters. Optional in development/test, required in production.
PIN_FINGERPRINT_SECRET=

# Defaults to true in production. Set to false only for plain-http local testing.
COOKIE_SECURE=
# true, false or the number of proxies in front of the API (Caddy on the VPS: 1).
TRUST_PROXY=false
# Shared with the Cloudflare Pages Function proxy (32+ chars): lets the API trust X-Client-IP from it.
PROXY_SHARED_SECRET=
# Comma separated dashboard origins allowed by CORS, e.g. https://dashboard.example
CORS_ORIGINS=

# Rate limits (per IP): owner login per minute, device pairing per hour.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_PAIR_MAX=10

# Object storage for presigned image uploads (R2 or B2, S3-compatible), private bucket. Set the four STORAGE_*
# values and API_PUBLIC_BASE_URL, or none; without them POST /v1/uploads answers 503. Images are served via
# <API_PUBLIC_BASE_URL>/v1/media/<key> (ADR-0015). Credentials live in the secret manager.
API_PUBLIC_BASE_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Legacy, optional: base URL of a former public bucket; URLs under it stay valid when saved.
STORAGE_PUBLIC_BASE_URL=

# Error reporting (Sentry). Unset = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
