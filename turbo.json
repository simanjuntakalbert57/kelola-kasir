{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": [],
      "env": ["TEST_DATABASE_URL"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTCONTAINERS_RYUK_DISABLED",
        "TESTCONTAINERS_HOST_OVERRIDE"
      ]
    }
  }
}
