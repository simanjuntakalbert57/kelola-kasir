{
  "name": "@kelola-kasir/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend API (Fastify + Drizzle + PostgreSQL)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "owner:create": "tsx src/scripts/create-owner.ts",
    "keys:generate": "tsx src/scripts/generate-jwt-key.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@kelola-kasir/contracts": "workspace:*",
    "@kelola-kasir/money": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "qrcode": "^1.5.4",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15"
  }
}
