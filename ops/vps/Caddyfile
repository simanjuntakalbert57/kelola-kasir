# HTTPS in front of the API (ADR-0012). Caddy gets and renews the Let's Encrypt certificate for
# API_DOMAIN by itself; DNS must point API_DOMAIN at the VPS and ports 80/443 must be open.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# Caddy replaces X-Forwarded-For with the real client address; the API trusts exactly one proxy.
	reverse_proxy api:3000

	request_body {
		max_size 10MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
}

# Pauls Job demo (DEAR-215, pauls-job-simulator docs/ops/demo-hosting.md). DEMO_DOMAIN defaults to
# pauls-demo.80-43-0-75.sslip.io in compose.yaml. The upstream is resolved per request, so Caddy starts
# without the demo container; that host then answers 502 and nothing else is affected.
{$DEMO_DOMAIN} {
	reverse_proxy pauls-demo:3000

	# defer: applied after the upstream's headers, so X-Robots-Tag is replaced, not duplicated.
	header {
		defer
		-Server
		X-Robots-Tag "noindex, nofollow"
	}
}
