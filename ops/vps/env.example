# Template for /opt/kelola-kasir/.env on the VPS (docs/ops/deploy.md step 5).
#   cp env.example .env && chmod 600 .env && nano .env
# Real values live only in that file and in the owner's password manager. Never commit them,
# never paste them into an issue or chat.

# Public hostname of the API (DNS A record -> VPS IP). Caddy requests the HTTPS certificate for it.
API_DOMAIN=api.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=owner@example.com

# PostgreSQL memory. Defaults fit 2 GB RAM; for 4 GB use 512MB / 1536MB.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB

# Database. Hex only (openssl rand -hex 32): they are embedded in connection URLs.
POSTGRES_PASSWORD=
BACKUP_DB_PASSWORD=

# Application secrets (deploy.md step 3).
JWT_PRIVATE_KEY=
PIN_FINGERPRINT_SECRET=
PROXY_SHARED_SECRET=

# Product photos, logos and QRIS images (R2 or B2). The bucket (kelola-kasir-media) stays PRIVATE; the API serves
# images at <API_PUBLIC_BASE_URL>/v1/media/<key> (ADR-0015). Set the four STORAGE_* values below plus
# API_PUBLIC_BASE_URL, or leave them all empty to disable uploads; the API refuses to start with a partial set.
# API_PUBLIC_BASE_URL is the address clients use, i.e. the Pages URL (ADR-0014), without a trailing path.
API_PUBLIC_BASE_URL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
# Legacy, optional: URL of a former public bucket. Leave empty on a private bucket.
STORAGE_PUBLIC_BASE_URL=

# Web Push notifications to the owner's laptop (ADR-0017). Created on the VPS by Actions → Configure Web Push; do not
# fill by hand. All three or none (the API refuses to start with a partial set). VAPID_PRIVATE_KEY is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Error reporting. staging during UAT, production after go-live.
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging

# Nightly backup, stored OFF the VPS (R2 or B2 bucket kelola-kasir-backup).
# Leave AGE_RECIPIENT empty to keep backups off (allowed during UAT only; required before go-live).
AGE_RECIPIENT=
BACKUP_TARGET=s3://kelola-kasir-backup/postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional: empty = derived from the endpoint (B2: s3.<region>.backblazeb2.com, R2: auto).
BACKUP_S3_REGION=
RETENTION_DAYS=30
# healthchecks.io ping URL: pinged after every successful backup; it e-mails the owner when a ping is missing.
BACKUP_HEARTBEAT_URL=
